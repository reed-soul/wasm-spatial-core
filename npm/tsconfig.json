{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "node.ts",
    "batch.ts",
    "draco.ts",
    "webgpu.ts",
    "abort.ts"
  ],
  "exclude": ["node_modules", "pkg", "pkg-node"]
}
