# Build artifacts
/target
/pkg
/pkg-*
/wasm-pkg
/_site

# npm package build outputs (wasm-pack → npm/pkg*, tsc → npm/*.js).
# The published tarball is assembled from these in CI; never commit them.
/npm/pkg
/npm/pkg-node
/npm/*.js

# W3.6 headless Cesium test — TMS terrain pyramid is regenerated at test time
# from the current WASM build (tests/terrain_tms_generate.mjs). Never commit.
/tests/fixtures/terrain-tms/
# Playwright test artifacts (screenshots, traces, error-context on failure).
/test-results/
/playwright-report/

# Node / npm
node_modules/
dist/
*.tgz

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Rust
**/*.rs.bk
*.pdb

# Wasm-pack
/wasm-pack.log

# Environment
.env
.env.local

# External agent/tool configs (not part of this repo)
arbor_config.yaml
.zcode/

# Mimosa security-scanner session state (local tool output)
.mimosa/
